setcps(125/60/4)

$: note(`
  ~@4 f#4@4 e4@2 d#4@2 c#4@4
  c#4@6 b3@2 c#4@2 e4@2 c#4@4
  c#4@12 c4@2 ~@2
  ~@4 f#4@4 e4@2 d#4@2 c#4@4
  c#4@6 b3@2 c#4@2 e4@2 c#4@4
  c#4@12 b3@2 b3@2
  ~@4 f#4@2 f#4@2 f#4@3 e4@5
  ~@4 f#4@2 f#4@2 f#4@3 e4@3 d#4@4
  b3@2 c#4@2 b3@2 c#4@4 c#4@4
